  m_Text: "\u0421\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440 \u0430\u0432\u0442\u043E\u0437\u0430\u043F\u0440\u0430\u0432\u043E\u0447\u043D\u043E\u0439
    \u0441\u0442\u0430\u043D\u0446\u0438\u0438: \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435
    \u0447\u0435\u0440\u0435\u0437 \u0440\u0435\u0430\u043B\u0438\u0437\u043C\r\n\r\n\u041E
    \u043F\u0440\u043E\u0435\u043A\u0442\u0435\r\n\r\n  \u041D\u0430\u0448 \u0441\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440
    \u2014 \u044D\u0442\u043E \u0432\u0438\u0440\u0442\u0443\u0430\u043B\u044C\u043D\u0430\u044F
    \u043C\u043E\u0434\u0435\u043B\u044C \u0430\u0432\u0442\u043E\u0437\u0430\u043F\u0440\u0430\u0432\u043A\u0438,
    \u0433\u0434\u0435 \u0432\u043E\u0441\u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u044F\u0442\u0441\u044F
    \u0447\u0440\u0435\u0437\u0432\u044B\u0447\u0430\u0439\u043D\u044B\u0435 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438,
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B\u0435 \u0432\u043E\u0437\u043D\u0438\u043A\u043D\u0443\u0442\u044C
    \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0439 \u0436\u0438\u0437\u043D\u0438.
    \u0415\u0433\u043E \u0446\u0435\u043B\u044C \u2014 \u043E\u0431\u0443\u0447\u0438\u0442\u044C
    \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B \u0438 \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432
    \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u043C\u0443 \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044E
    \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0440\u0438\u0441\u043A\u0430
    \u0438 \u0441\u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u0443 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438.\r\n\r\n\u0427\u0440\u0435\u0437\u0432\u044B\u0447\u0430\u0439\u043D\u044B\u0435
    \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438:\r\n1.\u0440\u0430\u0437\u043B\u0438\u0432
    \u0442\u043E\u043F\u043B\u0438\u0432\u0430 \u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u044C
    \u0441\u0440\u043E\u0447\u043D\u043E\u0439 \u043B\u043E\u043A\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438\r\n\r\n2.\u043A\u0443\u0440\u0435\u043D\u0438\u0435
    \u043D\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438 \u0410\u0417\u0421
    \u0438 \u043E\u0442\u0440\u0430\u0431\u043E\u0442\u043A\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439
    \u043F\u043E \u043F\u0440\u0435\u0434\u043E\u0442\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044E
    \u043F\u043E\u0436\u0430\u0440\u0430\r\n\r\n3.\u043D\u0430\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
    \u043B\u044E\u0434\u0435\u0439 \u043D\u0430 \u043F\u0440\u043E\u0435\u0437\u0436\u0435\u0439
    \u0447\u0430\u0441\u0442\u0438, \u043E\u0442\u0432\u043B\u0435\u0447\u0451\u043D\u043D\u044B\u0445
    \u0442\u0435\u043B\u0435\u0444\u043E\u043D\u043E\u043C, \u0438 \u0440\u0430\u0431\u043E\u0442\u0430
    \u043F\u043E \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u044E \u0440\u0438\u0441\u043A\u0430
    \u0414\u0422\u041F\r\n\r\n\u0417\u0430\u0447\u0435\u043C \u044D\u0442\u043E \u043D\u0443\u0436\u043D\u043E:\r\n\r\n\u2022
    \u043E\u0431\u0443\u0447\u0430\u0442\u044C \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B
    \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0439 \u0438 \u0431\u044B\u0441\u0442\u0440\u043E\u0439
    \u0440\u0435\u0430\u043A\u0446\u0438\u0438 \u0431\u0435\u0437 \u0443\u0433\u0440\u043E\u0437\u044B
    \u0434\u043B\u044F \u0436\u0438\u0437\u043D\u0438\r\n\r\n\u2022 \u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0443 \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432 \u0438
    \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432 \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435
    \u043F\u0440\u0430\u0432\u0438\u043B \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F
    \u043D\u0430 \u0437\u0430\u043F\u0440\u0430\u0432\u043A\u0435\r\n\r\n\u2022 \u043E\u0442\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0442\u044C
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445,
    \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0451\u043D\u043D\u044B\u0445
    \u043A \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438\r\n\r\n\u2022
    \u0441\u043D\u0438\u0436\u0430\u0442\u044C \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0441\u0442\u044C
    \u043E\u0448\u0438\u0431\u043E\u043A \u0438 \u043F\u043E\u0432\u044B\u0448\u0430\u0442\u044C
    \u0433\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u044C \u043A \u0447\u0440\u0435\u0437\u0432\u044B\u0447\u0430\u0439\u043D\u044B\u043C
    \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F\u043C\r\n\r\n\u041A\u043E\u043C\u0443
    \u044D\u0442\u043E \u043F\u043E\u043B\u0435\u0437\u043D\u043E\r\n  \u041F\u0440\u043E\u0435\u043A\u0442
    \u043F\u0440\u0435\u0434\u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u0434\u043B\u044F
    \u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u043A\u043E\u0432 \u0410\u0417\u0421,
    \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432, \u043E\u0431\u0443\u0447\u0430\u044E\u0449\u0438\u0445
    \u0446\u0435\u043D\u0442\u0440\u043E\u0432 \u0438 \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u0430
    \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0439. \u0414\u043B\u044F \u043A\u0430\u0436\u0434\u043E\u0433\u043E
    \u043E\u043D \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442 \u0441\u0432\u043E\u044E
    \u0437\u0430\u0434\u0430\u0447\u0443: \u043E\u0442 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0438
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u0432 \u0427\u0421 \u0434\u043E
    \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u044F \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043E\u0432
    \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 \u0438
    \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u043D\u0430\u0433\u043B\u044F\u0434\u043D\u043E\u0433\u043E
    \u0443\u0447\u0435\u0431\u043D\u043E\u0433\u043E \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430.\r\n"
